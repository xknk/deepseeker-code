{
  "name": "deepseeker-code",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "cd src/core && node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc -p src/core/tsconfig.json && tsc -p src/cli/tsconfig.json",
    "evals:task": "tsx --tsconfig src/core/tsconfig.json src/core/tests/evals/task.eval.ts",
    "evals:compaction": "tsx --tsconfig src/core/tsconfig.json src/core/tests/evals/compaction.eval.ts",
    "evals:risk": "tsx --tsconfig src/core/tsconfig.json src/core/tests/evals/risk-classifier.eval.ts",
    "cli:dev": "pnpm --filter ./src/cli dev",
    "cli:build": "pnpm --filter ./src/cli build",
    "cli:start": "pnpm --filter ./src/cli start"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^25.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
