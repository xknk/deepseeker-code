        "ignore": "^7.0.5",
        "openai": "^6.42.0",
        "undici": "^8.8.0",
        "vscode-ripgrep": "^1.13.2"
    },
    "devDependencies": {
        "@types/node": "^25.9.2",
        "@types/react": "^18.3.12",
