{
    "name": "deepseeker-code",
    "version": "1.0.49",
    "description": "DeepSeeker-Code 终端客户端（React Ink，in-process 直驱 runAgent）",
    "homepage": "https://github.com/xknk/deepSeekCode#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/xknk/deepSeekCode.git",
