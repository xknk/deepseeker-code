{
    "name": "deep-code",
    "version": "1.0.0",
    "description": "deepSeekCode 终端客户端（React Ink，in-process 直驱 runAgent）",
    "type": "module",
    "bin": {
        "deep-code": "./dist/cli.mjs"
    },
    "files": [
        "dist/cli.mjs"
    ],
    "scripts": {
        "dev": "tsx --tsconfig ./tsconfig.json ./src/main.tsx",
        "build": "node build.mjs",
        "start": "node dist/cli.mjs",
        "prepublishOnly": "node build.mjs",
        "typecheck": "tsc --noEmit"
    },
    "keywords": [
        "cli",
        "ai",
        "coding-assistant",
        "deepseek",
        "agent",
        "ink"
    ],
    "author": "fanqianliang <2438756801@qq.com>",
    "license": "MIT",
    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "ink": "5",
        "react": "18",
        "ignore": "^7.0.5",
        "openai": "^6.42.0",
        "undici": "^8.8.0",
        "vscode-ripgrep": "^1.13.2"
    },
    "devDependencies": {
        "@types/react": "^18.3.12",
        "esbuild": "^0.25.0"
    }
}
