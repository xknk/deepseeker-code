{
  "name": "deepseeker-code",
  "displayName": "DeepSeeker-Code",
  "description": "%desc%",
  "version": "1.0.68",
  "publisher": "deepseeker-code",
  "license": "MIT",
  "icon": "media/icon.png",
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "ai",
    "deepseek",
    "coding-assistant",
    "agent",
    "chat"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/xknk/deepSeekCode.git",
    "directory": "src/vscode"
  },
  "bugs": {
    "url": "https://github.com/xknk/deepSeekCode/issues"
  },
  "homepage": "https://github.com/xknk/deepSeekCode/blob/main/src/vscode/README.md",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "deepseekerCode.openChat",
        "title": "%cmd.openChat%",
        "icon": "$(sparkle)"
      },
      {
        "command": "deepseekerCode.newSession",
        "title": "%cmd.newSession%",
        "icon": "$(add)"
      },
      {
        "command": "deepseekerCode.abort",
        "title": "%cmd.abort%"
      },
      {
        "command": "deepseekerCode.togglePlanMode",
        "title": "%cmd.togglePlanMode%"
      },
      {
        "command": "deepseekerCode.toggleAutoMode",
        "title": "%cmd.toggleAutoMode%"
      },
      {
        "command": "deepseekerCode.listSessions",
        "title": "%cmd.listSessions%",
        "icon": "$(history)"
      },
      {
        "command": "deepseekerCode.selectModel",
        "title": "%cmd.selectModel%"
      },
      {
        "command": "deepseekerCode.selectProjectRoot",
        "title": "%cmd.selectProjectRoot%",
        "icon": "$(root-folder)"
      },
      {
        "command": "deepseekerCode.manageTrust",
        "title": "%cmd.manageTrust%"
      },
      {
        "command": "deepseekerCode.viewBatchQueue",
        "title": "%cmd.viewBatchQueue%"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "deepseekerCode.openChat",
          "group": "navigation@1",
          "when": "resourceScheme != 'output'"
        },
        {
          "command": "deepseekerCode.listSessions",
          "group": "navigation@2",
          "when": "resourceScheme != 'output'"
        },
        {
          "command": "deepseekerCode.newSession",
          "group": "navigation@3",
          "when": "resourceScheme != 'output'"
        }
      ]
    },
    "configuration": {
      "title": "DeepSeeker-Code",
      "properties": {
        "deepseekerCode.apiKey": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "%config.apiKey%"
        },
        "deepseekerCode.model": {
          "type": "string",
          "default": "",
          "description": "%config.model%"
        },
        "deepseekerCode.models": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "%config.models%"
        },
        "deepseekerCode.locale": {
          "type": "string",
          "enum": [
            "",
            "zh",
            "en"
          ],
          "default": "",
          "description": "%config.locale%"
        },
        "deepseekerCode.apiUrl": {
          "type": "string",
          "default": "",
          "description": "%config.apiUrl%"
        },
        "deepseekerCode.auxModel": {
          "type": "string",
          "default": "",
          "description": "%config.auxModel%"
        },
        "deepseekerCode.reasoningEffort": {
          "type": "string",
          "enum": [
            "",
            "high",
            "max"
          ],
          "default": "",
          "description": "%config.reasoningEffort%"
        },
        "deepseekerCode.thinking": {
          "type": "string",
          "enum": [
            "",
            "on",
            "off"
          ],
          "default": "",
          "description": "%config.thinking%"
        },
        "deepseekerCode.parallelSafeTools": {
          "type": "boolean",
          "default": true,
          "description": "%config.parallelSafeTools%"
        },
        "deepseekerCode.workflowConcurrency": {
          "type": "number",
          "default": 0,
          "description": "%config.workflowConcurrency%"
        },
        "deepseekerCode.workflowMaxSteps": {
          "type": "number",
          "default": 0,
          "description": "%config.workflowMaxSteps%"
        },
        "deepseekerCode.streamIdleTimeoutMs": {
          "type": "number",
          "default": 0,
          "description": "%config.streamIdleTimeoutMs%"
        },
        "deepseekerCode.openBeside": {
          "type": "boolean",
          "default": true,
          "description": "%config.openBeside%"
        }
      }
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "package": "npm run build && vsce package",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "vscode-ripgrep": "^1.13.2"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@vscode/codicons": "^0.0.36",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.25.0",
    "ignore": "^7.0.5",
    "openai": "^6.42.0",
    "typescript": "^6.0.3",
    "undici": "^8.8.0"
  }
}
